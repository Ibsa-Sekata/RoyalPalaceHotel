generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  fullName        String
  email           String           @unique
  passwordHash    String
  phone           String?
  role            Role             @default(GUEST)
  status          UserStatus       @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  guestProfile    Guest?           @relation("UserGuest")
  bookings        Booking[]        @relation("UserBookings")
  contactMessages ContactMessage[]
  foodOrders      FoodOrder[]       @relation("UserFoodOrders")
}

model Guest {
  id                 Int                 @id @default(autoincrement())
  fullName           String
  email              String?             @unique
  phone              String?
  nationality        String?
  guestType          GuestType           @default(NEW)
  notes              String?
  userId             Int?                @unique
  user               User?               @relation("UserGuest", fields: [userId], references: [id], onDelete: SetNull)
  bookings           Booking[]
  diningReservations DiningReservation[]
  foodOrders         FoodOrder[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Room {
  id            Int                @id @default(autoincrement())
  roomNumber    String             @unique
  name          String
  type          String
  pricePerNight Decimal            @db.Decimal(10, 2)
  maxGuests     Int
  beds          String
  size          String
  image         String
  description   String?
  status        RoomStatus         @default(AVAILABLE)
  bookings      Booking[]
  tasks         HousekeepingTask[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Booking {
  id              Int           @id @default(autoincrement())
  bookingNumber   String        @unique
  guestId         Int
  guest           Guest         @relation(fields: [guestId], references: [id])
  roomId          Int
  room            Room          @relation(fields: [roomId], references: [id])
  userId          Int?
  user            User?         @relation("UserBookings", fields: [userId], references: [id], onDelete: SetNull)
  checkIn         DateTime
  checkOut        DateTime
  guests          Int
  specialRequests String?
  status          BookingStatus @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cancelledAt     DateTime?

  @@index([userId])
  @@index([guestId])
  @@index([roomId])
  @@index([checkIn, checkOut])
}

model Payment {
  id                   Int           @id @default(autoincrement())
  invoiceNumber        String        @unique
  bookingId            Int
  booking              Booking       @relation(fields: [bookingId], references: [id])
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("ETB")
  method               PaymentMethod @default(CASH)
  status               PaymentStatus @default(UNPAID)
  transactionReference String?
  receiptData          String?
  receiptName          String?
  receiptMimeType      String?
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model HousekeepingTask {
  id          Int        @id @default(autoincrement())
  roomId      Int
  room        Room       @relation(fields: [roomId], references: [id])
  assignedTo  String?
  taskType    String
  description String?
  status      TaskStatus @default(PENDING)
  priority    String     @default("NORMAL")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ContactMessage {
  id        Int           @id @default(autoincrement())
  fullName  String
  email     String
  subject   String
  message   String
  reply     String?
  status    ContactStatus @default(NEW)
  userId    Int?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  repliedAt DateTime?
}

model DiningReservation {
  id                 Int                     @id @default(autoincrement())
  confirmationNumber String                  @unique
  guestId            Int
  guest              Guest                   @relation(fields: [guestId], references: [id])
  restaurantName     String
  reservationStart   DateTime
  reservationEnd     DateTime
  guests             Int
  tableNumber        String?
  specialRequests    String?
  status             DiningReservationStatus @default(PENDING)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([guestId])
  @@index([reservationStart, reservationEnd])
  @@index([restaurantName, reservationStart, reservationEnd])
}

model MenuCategory {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id          Int              @id @default(autoincrement())
  categoryId  Int
  category    MenuCategory     @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Decimal          @db.Decimal(10, 2)
  image       String?
  isAvailable Boolean          @default(true)
  sortOrder   Int              @default(0)
  orderItems  FoodOrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId, isAvailable])
}

model FoodOrder {
  id              Int             @id @default(autoincrement())
  orderNumber     String          @unique
  guestId         Int
  guest           Guest           @relation(fields: [guestId], references: [id])
  userId          Int?
  user            User?           @relation("UserFoodOrders", fields: [userId], references: [id], onDelete: SetNull)
  items           FoodOrderItem[]
  status          FoodOrderStatus @default(PENDING)
  orderType       String          @default("ROOM_SERVICE")
  subtotal        Decimal         @db.Decimal(10, 2)
  tax             Decimal         @db.Decimal(10, 2)
  totalAmount     Decimal         @db.Decimal(10, 2)
  currency        String          @default("ETB")
  deliveryLocation String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  confirmedAt     DateTime?
  preparingAt     DateTime?
  readyAt         DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  @@index([guestId, createdAt])
  @@index([status, createdAt])
}

model FoodOrderItem {
  id          Int       @id @default(autoincrement())
  orderId     Int
  order       FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  Int?
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name        String
  unitPrice   Decimal   @db.Decimal(10, 2)
  quantity    Int
  specialInstructions String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderId])
}

model HotelSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String
  entityId   Int?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

enum Role {
  ADMIN
  GUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum GuestType {
  NEW
  RETURNING
  VIP
}

enum RoomStatus {
  AVAILABLE
  BOOKED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MAINTENANCE
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum DiningReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum FoodOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}
